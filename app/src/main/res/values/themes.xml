<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Prism" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- 浅色底 → 状态栏/导航栏图标转深色 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 默认切页 = 平移分页：进页从右滑入、旧页向左让位；返回当前页向右滑出。
             缩放切页（相册/看图）由调用方关掉系统动画、页面自己画 -->
        <item name="android:windowAnimationStyle">@style/PrismAnim</item>
    </style>

    <style name="PrismAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
