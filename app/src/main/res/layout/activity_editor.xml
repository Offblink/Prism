<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/ed_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ed_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="18dp"
            android:text="@string/editor_back"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.2"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/editor_title"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ed_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="18dp"
            android:text="@string/editor_save"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:id="@+id/ed_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/ed_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/ed_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/fg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/editor_loading"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
