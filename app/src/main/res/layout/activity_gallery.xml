<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/gl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/gl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="18dp"
            android:text="@string/editor_back"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/gl_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:letterSpacing="0.2"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/gallery_title"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gl_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:fontFamily="monospace"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gl_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="3dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/gl_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/gallery_empty"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 遮罩：相册下拉展开时盖住网格，点它收起 -->
        <View
            android:id="@+id/gl_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33141416"
            android:visibility="gone" />

        <!-- 系统相册下拉：全宽贴顶，列 MediaStore 的 bucket -->
        <ScrollView
            android:id="@+id/gl_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gl_buckets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="6dp" />
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/gl_bottom"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/gl_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:enabled="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:text="@string/gallery_delete"
            android:textColor="@color/ch_r"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
