<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cam_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/cam_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 点按对焦框（点取景区时在指尖位置亮一下再淡出） -->
    <View
        android:id="@+id/cam_focus"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:alpha="0"
        android:background="@drawable/focus_ring"
        android:visibility="invisible" />

    <!-- 顶栏：中间一个「拍摄 / 调色」模式切换，下面 2px 指示条滑动 -->
    <FrameLayout
        android:id="@+id/cam_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/cam_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cam_mode_shoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/mode_shoot"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cam_mode_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/mode_edit"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:id="@+id/cam_mode_indicator"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="left|bottom"
            android:background="@color/fg" />
    </FrameLayout>

    <!-- 底部控制列：实时调色面板（WebView，与调色模式同一套控件）+ 相册入口/快门。
         放进一个竖列，系统栏 inset 加在底栏上时面板会自动被顶起来 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <WebView
            android:id="@+id/cam_controls"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            android:background="@android:color/transparent"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/cam_bottom"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="34dp"
            android:paddingEnd="34dp">

        <FrameLayout
            android:id="@+id/cam_gallery"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/frame_14"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/cam_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_gallery"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/cam_shutter"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:contentDescription="@string/cd_shutter"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/cam_shutter_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shutter_ring" />

            <View
                android:id="@+id/cam_shutter_disc"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_disc" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 右侧占位：保证快门在屏幕正中 -->
        <Space
            android:layout_width="46dp"
            android:layout_height="46dp" />
    </LinearLayout>

    </LinearLayout>

    <!-- 没给相机权限时的引导层 -->
    <LinearLayout
        android:id="@+id/cam_perm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/camera_permission_title"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/camera_permission_body"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cam_perm_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/pill_solid"
            android:paddingStart="26dp"
            android:paddingTop="12dp"
            android:paddingEnd="26dp"
            android:paddingBottom="12dp"
            android:text="@string/camera_permission_grant"
            android:textColor="@color/bg"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 拍摄黑闪：按下快门时盖一下再散掉（纯视觉，不拦截触摸） -->
    <View
        android:id="@+id/cam_shutter_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000"
        android:importantForAccessibility="no" />

</FrameLayout>
