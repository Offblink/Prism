<?xml version="1.0" encoding="utf-8"?>
<org.offblink.rgbcam.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/item_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:contentDescription="@string/gallery_title"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/item_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/select_overlay"
        android:visibility="gone" />

</org.offblink.rgbcam.SquareFrameLayout>
